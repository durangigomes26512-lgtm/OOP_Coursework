import java.time.LocalDate;

public class AdoptionRecord {

    // Properties
    private int recordID;
    private Pet pet;
    private User adopter;
    private LocalDate date;
    private double feePaid;

    // Constructor
    public AdoptionRecord(int recordID, Pet pet, User adopter, LocalDate date, double feePaid) {
        this.recordID = recordID;
        this.pet = pet;
        this.adopter = adopter;
        this.date = date;
        this.feePaid = feePaid;
    }

    // Getters
    public int getRecordID() {
        return recordID;
    }

    public Pet getPet() {
        return pet;
    }

    public User getAdopter() {
        return adopter;
    }

    public LocalDate getDate() {
        return date;
    }

    public double getFeePaid() {
        return feePaid;
    }

    // Display Record Details / Receipt
    public void displayRecordDetails() {
        System.out.println("===== ADOPTION RECEIPT =====");
        System.out.println("Record ID: " + recordID);
        System.out.println("Pet: " + pet.getName());
        System.out.println("Adopter: " + adopter.getName());
        System.out.println("Date of Adoption: " + date);
        System.out.println("Fee Paid: Rs. " + feePaid);
        System.out.println("============================");
    }
}
